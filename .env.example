# GEMINI_API_KEY: Required for live Gemini AI calls (TFAN chat). If unset, the
# chat runs in a rich simulated mode. Configure via the Secrets panel / Cloud
# Run env, never commit a real key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (Cloud Run service URL).
APP_URL="MY_APP_URL"

# ALLOWED_DOMAIN: Google Workspace domain that logins are restricted to.
ALLOWED_DOMAIN="truefootage.tech"

# ADMIN_EMAILS: Comma-separated allowlist of users granted the admin role.
# Everyone else on the allowed domain is a normal staff user. There is NO
# "email contains admin" backdoor anymore.
ADMIN_EMAILS="kevin.zelenakas@truefootage.tech"

# DRIVE_FOLDER_ID: The ID of the shared Google Drive folder containing UAD 3.6
# materials. Also settable in-app (Admin > System Config).
DRIVE_FOLDER_ID="1E7_DywyR2785lgZCNs8ZfvYmFi10r-6F"

# FIREBASE_PROJECT_ID: GCP/Firebase project used for Firestore + auth token
# verification. Defaults to the value baked into firebase-applet-config.json.
FIREBASE_PROJECT_ID="uad-36-knowledge-base"

# STORAGE_BACKEND: "firestore" | "file". Leave unset for auto-detect (Firestore
# on Cloud Run, local JSON file in dev). Force "file" for a local no-Google run.
# STORAGE_BACKEND="file"

# DEV_AUTH: Set to "true" ONLY for local development to allow a header/body
# email login without Google. MUST stay unset/false in production.
# DEV_AUTH="false"

# NOTEBOOKLM_PROJECT_ID: GCP/Vertex project for NotebookLM Enterprise Q&A.
NOTEBOOKLM_PROJECT_ID="your_gcp_project_id_here"
